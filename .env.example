# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Secret key is used server-side only (API routes) to create Checkout
# Sessions and charge the later balance. No publishable/client-side key is
# needed -- the booking page redirects straight to a Stripe-hosted Checkout
# URL rather than embedding Stripe Elements.
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint. Register that URL in
# the Stripe Dashboard (Developers -> Webhooks) listening for
# checkout.session.completed, then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=quotes@royalrollers.example
OWNER_ALERT_EMAIL=owner@royalrollers.example
# If set, every outgoing email (customer + owner alerts) is redirected here
# instead of the real recipient -- useful for local/staging testing. Leave
# unset in production.
EMAIL_OVERRIDE_TO=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://royalrollers.example

# --- Business rules ---
# Percentage of the total quote charged as a deposit at booking.
DEPOSIT_PERCENT=25

# --- Business rules: instant-estimate pricing (placeholder figures) ---
# Same status DEPOSIT_PERCENT had before that got decided -- these are
# scaffolded placeholders, not a real pricing decision. Non-binding: the
# real price is always set manually via PATCH /api/quote/[id]/price.
# No API key needed for the distance lookup itself -- see
# app/api/route-distance/route.ts (free ZIP geocoding, no signup).
ESTIMATE_BASE_FEE_CENTS=15000
ESTIMATE_CARRIER_PER_MILE_CENTS=100
ESTIMATE_PERSONAL_DRIVER_PER_MILE_CENTS=80
ESTIMATE_ENCLOSED_SURCHARGE_PERCENT=30
ESTIMATE_NOT_RUNNING_FLAT_ADD_CENTS=20000
ESTIMATE_RANGE_SPREAD_PERCENT=5
ESTIMATE_CARRIER_LONG_HAUL_DISCOUNT_THRESHOLD_MILES=1300
ESTIMATE_CARRIER_LONG_HAUL_DISCOUNT_PERCENT=15

# --- Internal ops ---
# Shared secret for the stopgap /api/charge-balance route until a real
# trigger (admin UI, cron, webhook) replaces it. Generate a long random
# string, e.g. `openssl rand -hex 32`.
INTERNAL_OPS_SECRET=
